# Copia a deploy/.env.docker (no se versiona) y completa los valores.

DB_PASSWORD=cambia-esta-clave
DB_ROOT_PASSWORD=cambia-esta-otra-clave

# Clave para firmar los JWT y cifrar los secretos TOTP. Genera una con:  openssl rand -hex 32
# Si cambia, caducan las sesiones y los secretos TOTP guardados dejan de poder leerse.
SECRET_KEY=

# Orígenes del navegador que pueden llamar a la API (el panel y, si hace falta, tus apps). Separados por coma.
CORS_ORIGINS=https://id.dominio.com

# Correo saliente para los códigos de verificación y de acceso
MAIL_HOST=smtp.ejemplo.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@dominio.com
MAIL_PASSWORD=
MAIL_FROM=NooxID <no-reply@dominio.com>
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# Inicio de sesión con Google (opcional): el mismo ID de cliente que VITE_GOOGLE_CLIENT_ID del panel
GOOGLE_CLIENT_ID=
