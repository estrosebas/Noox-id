  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Script que se ejecuta antes de cada request",
          "// Configurar variables globales si no existen",
          "if (!pm.globals.has('base_url')) {",
          "    pm.globals.set('base_url', 'http://localhost:5000');",
          "}",
          "",
          "// Log del request actual",
          "console.log('🚀 Ejecutando: ' + pm.request.name);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Script que se ejecuta después de cada request",
          "// Log de respuesta",
          "console.log('✅ Completado: ' + pm.request.name + ' - Status: ' + pm.response.code);",
          "",
          "// Test global para verificar tiempo de respuesta",
          "pm.test('Response time is less than 5000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "// Test global para verificar que la respuesta sea JSON válido",
          "if (pm.response.headers.get('Content-Type') && pm.response.headers.get('Content-Type').includes('application/json')) {",
          "    pm.test('Response is valid JSON', function () {",
          "        pm.response.to.be.json;",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ]
