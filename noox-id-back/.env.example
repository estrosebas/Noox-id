# Copia este archivo a .env y completa los valores. .env está en .gitignore.

DATABASE_URL=mysql+pymysql://root:password@localhost/nooxid
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# Si cambias SECRET_KEY se invalidan los JWT y los secretos TOTP ya guardados.

# --- Servidor ---
# Sin SECRET_KEY se genera una clave aleatoria en instance/secret_key (no se versiona). En producción, defínela.
# FLASK_DEBUG activa el depurador y recarga automática; solo se permite en 127.0.0.1.
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
# Orígenes extra permitidos por CORS (separados por coma). Ya incluye localhost:5173, 5174 y 8080.
CORS_ORIGINS=
# Los administradores no se definen aquí: viven en la base de datos (roles y permisos).
# El primero se crea con: python manage.py make-admin correo@empresa.com

# --- Inicio de sesión con Google ---
# ID de cliente OAuth (Google Cloud Console > Credenciales). Sin él, el acceso con Google está deshabilitado.
# El frontend usa el mismo valor en VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# --- Correo saliente (código de acceso por correo; siempre disponible como alternativa al rostro) ---
MAIL_HOST=smtp.ejemplo.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@ejemplo.com
MAIL_PASSWORD=
MAIL_FROM=NooxID <no-reply@ejemplo.com>
MAIL_USE_TLS=true        # STARTTLS (puerto 587)
MAIL_USE_SSL=false       # SSL directo (puerto 465); si lo activas, pon MAIL_USE_TLS=false
MAIL_TIMEOUT=10
# Solo desarrollo: imprime el código en la consola del servidor en lugar de enviar el correo.
MAIL_CONSOLE=false

# --- Código por correo ---
OTP_EMAIL_TTL_MINUTES=10        # vigencia del código
OTP_EMAIL_MAX_ATTEMPTS=5        # intentos por código
OTP_EMAIL_RESEND_SECONDS=60     # espera mínima entre dos envíos al mismo usuario
OTP_EMAIL_MAX_PER_HOUR=5        # envíos máximos por hora y usuario
